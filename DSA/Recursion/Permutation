//In this i solved using love babbar but i can also try to solve using Output vector and then push back it in ans.

#include <iostream>
#include <vector>
using namespace std;
class Solution {
    private:
    void solve(vector <int> nums, int index,vector <vector <int>> &finalans)
    {
        //Basecase
        if(index>=nums.size())
        {
            finalans.push_back(nums);
            return ;
        }

        //Process
        for(int i=index;i<nums.size();i++)
        {
            swap(nums[index],nums[i]);
            solve(nums,index+1,finalans);
            //Backtracking
            swap(nums[index],nums[i]);
        }
    }
public:
    vector<vector<int>> permute(vector<int>& nums) 
    {
        int index=0;
        vector<int> output;
        vector <vector <int>> finalans;
        //Helper function
        solve(nums,index,finalans);
        return finalans; 
    }
};